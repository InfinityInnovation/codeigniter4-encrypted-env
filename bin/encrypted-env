<?php

declare(strict_types=1);

$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
];

$autoload = null;

foreach ($autoloadPaths as $path) {
    if (is_file($path)) {
        $autoload = $path;
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, "Error: Composer autoload.php not found.\n");
    exit(1);
}

require_once $autoload;

use EncryptedEnv\Crypto\AesGcmCipher;
use EncryptedEnv\Env\EnvFileManager;
use EncryptedEnv\Env\EnvFileTransformer;
use EncryptedEnv\Env\MasterKeyResolver;

function fail(string $message): never
{
    fwrite(STDERR, "Error: {$message}\n");
    exit(1);
}

$command = $argv[1] ?? null;

if (! in_array($command, ['encrypt', 'encrypt-file', 'decrypt-file'], true)) {
    fail('Usage: encrypted-env encrypt|encrypt-file|decrypt-file [--file=PATH] [--yes]');
}

$file = null;
$confirmed = false;

for ($index = 2; $index < count($argv); $index++) {
    $argument = $argv[$index];

    if ($argument === '--yes') {
        $confirmed = true;
    } elseif (str_starts_with($argument, '--file=')) {
        $file = substr($argument, strlen('--file='));
    } elseif ($argument === '--file') {
        $file = $argv[++$index] ?? null;

        if (! is_string($file) || $file === '' || str_starts_with($file, '--')) {
            fail('The --file option requires a file path.');
        }
    } else {
        fail('Unknown option. Do not pass secrets as command-line arguments.');
    }
}

try {
    $key = (new MasterKeyResolver())->resolve();
} catch (Throwable $exception) {
    fail($exception->getMessage());
}

if ($command === 'encrypt-file' || $command === 'decrypt-file') {
    try {
        $cwd = getcwd();

        if ($cwd === false) {
            fail('Unable to determine the working directory.');
        }

        $path = $file ?? $cwd . DIRECTORY_SEPARATOR . '.env';

        if (
            ! str_starts_with($path, DIRECTORY_SEPARATOR)
            && preg_match('/^[A-Za-z]:[\\\\\/]/', $path) !== 1
            && ! str_starts_with($path, '\\\\')
        ) {
            $path = $cwd . DIRECTORY_SEPARATOR . $path;
        }

        if (is_link($path) || ! is_file($path)) {
            fail('The .env file is missing or is not a regular file.');
        }

        if (! is_readable($path) || ! is_writable($path)) {
            fail('The .env file is not accessible.');
        }

        if ($command === 'decrypt-file' && ! $confirmed) {
            if (! function_exists('stream_isatty') || ! stream_isatty(STDIN)) {
                fail('Decryption requires explicit confirmation. Pass --yes.');
            }

            fwrite(STDERR, 'This writes plaintext secrets to disk. Continue? [y/N] ');
            $answer = fgets(STDIN);

            if (! is_string($answer) || strtolower(trim($answer)) !== 'y') {
                fail('Decryption cancelled.');
            }
        }

        $manager = new EnvFileManager(
            new EnvFileTransformer(new AesGcmCipher($key))
        );
        $manager->process($path, $command === 'encrypt-file');

        echo "Environment file processed successfully." . PHP_EOL;
        exit(0);
    } catch (Throwable $exception) {
        fail($exception->getMessage());
    }
}

if (! function_exists('shell_exec')) {
    fail('Secure terminal input is unavailable.');
}

if (! function_exists('stream_isatty') || ! stream_isatty(STDIN)) {
    fail('An interactive terminal is required.');
}

fwrite(STDERR, 'Enter secret value: ');

try {
    $stty = shell_exec('stty -g 2>/dev/null');

    if (! is_string($stty) || trim($stty) === '') {
        fail('Unable to configure secure terminal input.');
    }

    $stty = trim($stty);

    try {
        shell_exec('stty -echo');
        $value = fgets(STDIN);
    } finally {
        shell_exec('stty ' . escapeshellarg($stty));
        fwrite(STDERR, PHP_EOL);
    }

    if ($value === false) {
        fail('Unable to read secret.');
    }

    $cipher = new AesGcmCipher($key);
    echo $cipher->encrypt(rtrim($value, "\r\n")) . PHP_EOL;
} catch (Throwable $exception) {
    fail($exception->getMessage());
}
